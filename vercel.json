{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "portafolio.contolaprincesa.com"
        }
      ],
      "destination": "https://contolaprincesa.com/:path*",
      "permanent": true
    },
    {
      "source": "/qr",
      "destination": "/?utm_source=qr&utm_medium=offline&utm_campaign=activacion",
      "permanent": false
    }
  ]
}
